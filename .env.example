# =============================================================================
# UniHome Docker Compose environment
# Copy this file to .env and replace placeholder values before running Docker.
# =============================================================================

# Database
POSTGRES_DB=unihome
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password1234

# Backend security
# Replace with a long random base64 secret for real deployments.
JWT_SECRET=c2VjdXJlLWtleS1mb3ItdW5paG9tZS0zMi1ieXRlcy0xMjM0NTY3ODkw
JWT_EXPIRATION_MS=3600000

# AI service
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL_NAME=gemini-flash-latest

# Browser-facing frontend API URL
BACKEND_PORT=8095
VITE_API_URL=http://localhost:8095

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=