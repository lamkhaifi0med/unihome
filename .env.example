# =============================================================================
# UniHome Docker Compose environment
# Copy this file to .env and replace placeholder values before running Docker.
# =============================================================================

# Database
POSTGRES_DB=unihome
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password1234
DB_PORT=5432

# Backend security
# Replace with a long random base64 secret for real deployments.
JWT_SECRET=c2VjdXJlLWtleS1mb3ItdW5paG9tZS0zMi1ieXRlcy0xMjM0NTY3ODkw
JWT_EXPIRATION_MS=3600000

# Internal AI <-> Spring chatbot tool-calling shared secret.
# REQUIRED. Must be at least 32 characters. Generate with:
#   openssl rand -hex 32         (Linux/macOS)
#   [Convert]::ToHexString((1..32 | %{ Get-Random -Max 256 }))   (Windows PowerShell)
INTERNAL_API_KEY=replace-with-a-64-char-hex-string

# AI service
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL_NAME=gemini-flash-latest
AI_SERVICE_PORT=8000
# Internal URL the AI service uses to reach Spring (Docker network).
BACKEND_INTERNAL_URL=http://api:8080
CHATBOT_TOOL_TIMEOUT_S=15
CHATBOT_TOOL_MAX_TURNS=3
CHATBOT_TOOL_MAX_RESULTS=20

# Browser-facing frontend API URL
BACKEND_PORT=8095
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8095

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=