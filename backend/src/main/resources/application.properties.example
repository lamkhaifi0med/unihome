# =============================================================================
# CONFIGURATION BASE DE DONNEES (PostgreSQL + PostGIS)
# =============================================================================
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/unihome}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

# =============================================================================
# CONFIGURATION JPA / HIBERNATE
# =============================================================================
# CRUCIAL : "validate" verifie que ton code Java correspond a ton SQL manuel.
# Cela empeche Hibernate de supprimer tes Triggers, Enums et Vues SQL.
spring.jpa.hibernate.ddl-auto=validate

# Affiche les requetes SQL dans la console (utile pour le debug)
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Mapping des noms : assure que Java 'nomPrenom' cherche 'nom_prenom' en SQL
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# =============================================================================
# CONFIGURATION DES SERVICES EXTERNES (Placeholders)
# =============================================================================
# URL du microservice Python pour le scoring IA
python.service.url=${PYTHON_SERVICE_URL:http://localhost:8000}

# Identifiants Cloudinary pour le stockage des photos
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
cloudinary.api-key=${CLOUDINARY_API_KEY:}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:}

# =============================================================================
# CONFIGURATION SERVEUR & LOGS
# =============================================================================
server.port=8080
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# -----------------------------------------
# Juste pour le test (optionnel)
spring.security.user.name=${BASIC_AUTH_USER:admin}
spring.security.user.password=${BASIC_AUTH_PASSWORD:}

# =============================================================================
# CONFIGURATION JWT
# =============================================================================
jwt.secret=${JWT_SECRET:c2VjdXJlLWtleS1mb3ItdW5paG9tZS0zMi1ieXRlcy0xMjM0NTY3ODkw}
jwt.expirationMs=${JWT_EXPIRATION_MS:3600000}

# =============================================================================
# CONFIGURATION EMAIL (SMTP)
# =============================================================================
spring.mail.host=${SMTP_HOST:smtp.example.com}
spring.mail.port=${SMTP_PORT:587}
spring.mail.username=${SMTP_USERNAME:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Lien de confirmation (utilise {token} comme placeholder)
app.confirmation.base-url=${CONFIRMATION_BASE_URL:http://localhost:8095/api/auth/confirm?token={token}}
app.reset.base-url=${RESET_PASSWORD_BASE_URL:http://localhost:5173/reset-password?token={token}}
app.mail.from=${MAIL_FROM:}
